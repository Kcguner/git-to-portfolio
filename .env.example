# Üretimdeki canonical ve sosyal paylaşım URL'i.
# NEXT_PUBLIC_ değişkenleri istemci paketine gömülür ve build sırasında dondurulur;
# bu nedenle gizli bilgi içermemeli ve Vercel'de build'den önce doğru Production değeriyle tanımlanmalıdır.
# Yalnızca HTTPS kullanın; sorgu/fragment ve sondaki "/" eklemeyin.
NEXT_PUBLIC_SITE_URL=https://git-to-portfolio.vercel.app

# İsteğe bağlı, istemciye açık kaynak deposu URL'si (varsayılan: Kcguner/git-to-portfolio).
# Bu değer de NEXT_PUBLIC_ olduğu için build sırasında paketlenir; yalnızca genel URL verin.
NEXT_PUBLIC_GITHUB_REPO_URL=https://github.com/Kcguner/git-to-portfolio

# İsteğe bağlı: GitHub API rate-limit artırımı için sunucu tarafı token.
# NEXT_PUBLIC_ ÖN EKI KULLANMAYIN: bu değer hiçbir istemci paketine gömülmemelidir.
# Vercel'de Production/Preview/Development kapsamını bilinçli seçin, mümkünse yalnızca
# Production kullanın ve en az yetkiyle (herkese açık depo verilerini salt okunur okuyacak)
# fine-grained bir token kullanın. Gerçek token'ı .env*, istemci kodu veya loglara yazmayın.
GITHUB_TOKEN=
